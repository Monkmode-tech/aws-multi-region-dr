# Copy to terraform.tfvars (git-ignored). Never put AWS keys here - use
# `aws sso login` / AWS_PROFILE for credentials.
owner       = "caleb-tetteh"
domain_name = "example.com" # the domain you bought; Route 53 hosted zone must exist
alert_email = "you@example.com"

# api_subdomain       = "ledger"
# deletion_protection = true  # set false and apply before `terraform destroy`
# enable_s3_rtc       = false
# lambda_reserved_concurrency = 10  # only if `aws lambda get-account-settings` shows ConcurrentExecutions >= 1000
